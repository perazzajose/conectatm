{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "Deno": "readonly"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error"
  },
  "ignorePatterns": [
    "dist/**",
    ".wrangler/**",
    "test-results/**",
    "playwright-report/**",
    "public/admin-panel.html"
  ]
}
