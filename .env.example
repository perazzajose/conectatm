# Copiá este archivo como .env y completá con los datos de tu proyecto de Supabase
# (Supabase > botón Connect, o Settings > API Keys). Va la publishable key; nunca la secret / service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Cloudflare Turnstile ("no soy un robot" en Subí tu CV). Es la clave PÚBLICA (site key).
# La secreta va solo en Supabase > Edge Functions > Secrets como TURNSTILE_SECRET.
VITE_TURNSTILE_SITE_KEY=
